generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())

  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("staff")
  active       Boolean  @default(true)
  approved     Boolean  @default(true)

  passwordResetTokens PasswordResetToken[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id            String         @id @default(cuid())

  name          String
  phone         String         @unique
  email         String?

  conversations Conversation[]
  appointments  Appointment[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())

  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])

  procedure   String
  date        DateTime
  durationMin Int      @default(60)

  status      String   @default("scheduled")

  notes       String?

  googleEventId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([clientId])
  @@index([status])
}

model Procedure {
  id          String   @id @default(cuid())

  name        String   @unique
  description String?
  category    String   @default("Facial")
  price       Float
  durationMin Int      @default(60)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model QuickReply {
  id        String   @id @default(cuid())

  title     String   @unique
  shortcut  String?  @unique
  content   String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model Conversation {
  id             String    @id @default(cuid())

  whatsappJid    String    @unique
  whatsappJidAlt String?

  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])

  messages       Message[]

  unreadCount    Int       @default(0)
  lastReadAt     DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Message {
  id              String    @id @default(cuid())

  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])

  content         String
  fromMe          Boolean
  messageType     String

  mimeType        String?
  fileName        String?
  mediaPath       String?

  whatsappMsgId   String?   @unique

  replyToMessageId     String?
  quotedWhatsappMsgId  String?
  quotedContent        String?
  quotedFromMe         Boolean?
  quotedMessageType    String?

  createdAt       DateTime  @default(now())
}
