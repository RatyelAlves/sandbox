PORT=3333

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/estheticflow"

# Evolution API local (Docker em localhost:8080)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_INSTANCE="estheticflow"
EVOLUTION_API_KEY="admin"
EVOLUTION_INSTANCE_KEY=""

# URL que a Evolution (Docker) usa para chamar o backend
WEBHOOK_BASE_URL="http://host.docker.internal:3333"

# Google Gemini — respostas automáticas com IA
GEMINI_API_KEY=""
# Modelos válidos na sua chave (mai/2026): gemini-2.5-flash, gemini-2.0-flash
# Evite gemini-flash-latest com function calling (exige thought_signature)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-2.0-flash"
# true = responde automaticamente quando o paciente manda mensagem
GEMINI_AUTO_REPLY="false"

# Google Calendar — OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3333/google/callback"
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CALENDAR_EMAIL=""
FRONTEND_URL="http://localhost:5173"

# Autenticação (JWT)
JWT_SECRET="altere-para-um-segredo-forte"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="admin@estheticflow.local"
ADMIN_PASSWORD="admin123"
PASSWORD_RESET_EXPIRES_MIN=60

# E-mail (recuperação de senha) — opcional
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EstheticFlow <noreply@sua-clinica.com>"

# Horário de funcionamento da clínica (agenda IA)
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
CLINIC_SLOT_INTERVAL_MIN=60
